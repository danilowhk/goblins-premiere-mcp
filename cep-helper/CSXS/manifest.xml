<?xml version="1.0" encoding="UTF-8"?>
<!-- Goblins CEP Helper. CEP 11+ (Premiere 25+); Premiere 26.5.2 ships CEP 12. -->
<ExtensionManifest Version="11.0" ExtensionBundleId="com.livus.goblins.cephelper" ExtensionBundleVersion="0.1.0" ExtensionBundleName="Goblins CEP Helper" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.livus.goblins.cephelper.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[25.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.livus.goblins.cephelper.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/goblins_helper.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Goblins CEP Helper</Menu>
          <Geometry>
            <Size>
              <Height>180</Height>
              <Width>300</Width>
            </Size>
            <MinSize>
              <Height>120</Height>
              <Width>220</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
